%% Zettings search dataflow (indexing + querying).
%% Render: `mmdc -i search-dataflow.mmd -o search-dataflow.svg`

flowchart LR
    subgraph Producers
        M1[Module: display]
        M2[Module: audio]
        M3[Module: network]
        MN[Module: ...]
    end

    subgraph Indexing
        LOADER[zettings-core<br/>plugin loader]
        REG[zettings-search<br/>Index::insert]
        TV[tantivy<br/>RAMDirectory<br/>under<br/>~/.cache/zyntrix/]
    end

    subgraph Query
        QFE[Frontend search box<br/>80ms debounce]
        QPARSE[Query parser<br/>+ synonyms map]
        QFUZZY[strsim<br/>Levenshtein]
        QRANK[Ranker<br/>recent + frequent + weight]
        QHITS[SearchHit[]]
    end

    M1 -- SettingsEntry --> LOADER
    M2 -- SettingsEntry --> LOADER
    M3 -- SettingsEntry --> LOADER
    MN -- SettingsEntry --> LOADER
    LOADER --> REG
    REG --> TV

    QFE --> QPARSE
    QPARSE --> QFUZZY
    QFUZZY --> TV
    TV --> QRANK
    QRANK --> QHITS
    QHITS --> QFE

    TV -.incremental.-> LOADER
