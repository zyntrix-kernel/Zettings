%% Zettings IPC sequence — frontend invoke through elevated command.
%% Render: `mmdc -i ipc-sequence.mmd -o ipc-sequence.svg`

sequenceDiagram
    autonumber
    participant FE as Frontend (React)
    participant IPC as zettings-ipc<br/>(Tauri command)
    participant POL as zettings-polkit
    participant BUS as zettings-bus
    participant DOMAIN as zettings-<domain><br/>(e.g. zettings-network)
    participant SYS as Linux service<br/>(NetworkManager via zbus)
    participant PKA as polkit-agent<br/>(polkit-kde-agent)

    FE->>IPC: invoke("network_set_hostname", {name})
    IPC->>POL: check_authorization(<br/>ActionId::zettings(<br/>"network","set-hostname"))
    alt is_mock (Windows dev)
        POL-->>IPC: Authorized
    else Linux
        POL->>PKA: CheckAuthorization<br/>subject=system-bus-name
        PKA->>PKA: prompt user via OS dialog
        PKA-->>POL: Challenge | Denied | Authorized
    end
    alt Authorized or Challenge
        IPC->>DOMAIN: set_hostname(name)
        DOMAIN->>BUS: publish NetworkConfigChanged
        DOMAIN->>SYS: org.freedesktop.NetworkManager<br/>.SetHostname
        SYS-->>DOMAIN: ack
        DOMAIN-->>IPC: Ok(SetHostnameResult)
        IPC-->>FE: serialized SetHostnameResult
        BUS-->>FE: stream event (live update)
    else Denied
        POL-->>IPC: Err(PolkitError) or Authorization::Denied
        IPC-->>FE: serialized PolkitDenied error
    end
