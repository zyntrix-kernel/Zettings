[Desktop Entry]
Version=1.0
Type=Application
Name=Zettings
GenericName=System Settings
Comment=System settings and hardware configuration for Zyntrix OS
Exec=zettings %u
Icon=org.zyntrix.zettings
Terminal=false
Categories=Settings;HardwareSettings;DesktopSettings;Qt;KDE;
