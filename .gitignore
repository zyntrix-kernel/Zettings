# Zettings repository — do not edit by hand. Regenerate via `tools/format` if needed.

# -----------------------------
# Rust / Cargo
# -----------------------------
target/
**/*.rs.bk
*.pdb
Cargo.lock.bak
*.rs.png

# -----------------------------
# Node / pnpm / Vite
# -----------------------------
node_modules/
dist/
dist-ssr/
.vite/
.turbo/
.cache/
.parcel-cache/
.next/
.nuxt/
*.local
*.log
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# -----------------------------
# Tauri
# -----------------------------
src-tauri/target/
src-tauri/gen/
src-tauri/WixTools/
src-tauri/.cargo/
**/tauri.conf.json.bak

# ts-rs generated bindings are committed only when deterministic and used in CI.
# Ignored here per module-local convention; central bindings ARE committed.
apps/*/src-tauri/bindings/
crates/*/bindings/
!packages/ts-bindings/

# -----------------------------
# Testing / coverage
# -----------------------------
.tarpaulin/
target/tarpaulin/
coverage/
.nyc_output/
*.lcov
.playwright/
playwright-report/
test-results/

# -----------------------------
# Editor / OS
# -----------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# -----------------------------
# Secrets / local-only
# -----------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.toml

# -----------------------------
# Operational scratch
# -----------------------------
*.bench.svg
*.profraw
flamegraph.svg
perf.data*

